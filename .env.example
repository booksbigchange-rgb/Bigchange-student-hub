# Secrets are intentionally blank. Follow DEPLOYMENT.md before starting.
# ─── Database ──────────────────────────────────────────
DATABASE_URL=
DB_USER=mis_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=mis_ilsms

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── API ───────────────────────────────────────────────
PORT=4000
API_HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6381

# ─── MinIO / S3 ───────────────────────────────────────
MINIO_USER=
MINIO_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mis-uploads
